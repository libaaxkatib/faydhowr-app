APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Comma-separated list of origins allowed to call the API (config/cors.php).
# Set this to the real Web Panel domain(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Employee document storage (all optional; the defaults keep today's behaviour: documents on the local disk) ---
# Disk that receives NEW uploads. Each document records its own disk, so older documents stay reachable after a change.
# Use r2_documents for the private Cloudflare R2 bucket (requires league/flysystem-aws-s3-v3 and the R2_DOCUMENTS_* values).
HR_DOCUMENTS_DISK=local
# Recovery copy written by "php artisan hr:documents-mirror" (empty = no mirror). Use hr_documents_mirror_volume for a Railway volume.
HR_DOCUMENTS_MIRROR_DISK=
HR_DOCUMENTS_MIRROR_ROOT=
HR_DOCUMENTS_VERIFY_READBACK=true
HR_DOCUMENTS_VERIFY_ON_DOWNLOAD=true
# Cloudflare R2 (private bucket, bucket-scoped API token). Supply real values ONLY through the host's secret variables - never commit them.
R2_DOCUMENTS_ENDPOINT=
R2_DOCUMENTS_BUCKET=
R2_DOCUMENTS_ACCESS_KEY_ID=
R2_DOCUMENTS_SECRET_ACCESS_KEY=
R2_DOCUMENTS_REGION=auto

SMS_DRIVER=log

GOOGLE_CLIENT_IDS=

UPLOADS_DISK=local

# Required in production: HMAC secret for verifying manual payment webhooks.
# Leave empty locally to use the built-in development secret; webhooks are
# rejected in production when this is unset.
PAYMENT_MANUAL_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
